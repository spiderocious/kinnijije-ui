# Base URL of the cookiepot backend API. No trailing slash.
VITE_API_BASE_URL=http://localhost:4000

# Deployment environment: development | staging | production
VITE_APP_ENV=development

# Analytics providers, comma-separated: mixpanel, console. EMPTY IS VALID and
# means analytics is a no-op. `console` logs to the browser console.
VITE_ANALYTICS_PROVIDERS=
# Required only when `mixpanel` is in the list above.
VITE_MIXPANEL_TOKEN=
